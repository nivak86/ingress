# Keep automatic-HTTPS cert management, but never auto-redirect HTTP→HTTPS: the
# public path below is HTTP-only on purpose (Cloudflare terminates TLS at the
# edge and dials the tunnel to caddy:80). A redirect here would break it.
{
	auto_https disable_redirects
}

# ── Public path ─────────────────────────────────────────────────────────────
# Reached only through the Cloudflare tunnel (cloudflared → caddy:80). Cloudflare
# Access authenticates and injects Cf-Access-Authenticated-User-Email upstream.
http://kavinb.com, http://www.kavinb.com {
	encode zstd gzip
	redir /money /money/ 308
	redir /workout /workout/ 308
	redir /health /health/ 308
	redir /trade /trade/ 308
	redir /survey https://oceanfrontsurvey.com/ 308
	redir /survey/ https://oceanfrontsurvey.com/ 308
	redir /survey-admin /survey-admin/ 308
	handle_path /money/* {
		reverse_proxy money_api:8000
	}
	handle_path /workout/api/* {
		reverse_proxy workout_api:8000
	}
	handle_path /workout/* {
		reverse_proxy workout_api:8000
	}
	handle_path /health/* {
		reverse_proxy health_api:8000
	}
	handle_path /trade/* {
		reverse_proxy trade_web:80
	}
	# Oceanfront survey (nivak86/oceanfront-survey). The page and its submit endpoint are public
	# (Access bypass on kavinb.com/survey); the identity header is stripped so nothing on this route
	# can pass as signed in. The dashboard sits behind Access at /survey-admin.
	handle_path /survey/* {
		request_header -Cf-Access-Authenticated-User-Email
		rewrite * /public{uri}
		reverse_proxy survey_api:8000
	}
	handle_path /survey-admin/* {
		rewrite * /admin{uri}
		reverse_proxy survey_api:8000
	}
	handle {
		respond "kavinb.com online. Money is at /money. Workout is at /workout. Health is at /health." 200
	}
}

# ── oceanfrontsurvey.com (public) ───────────────────────────────────────────
# Reached only through the Cloudflare tunnel. No Cloudflare Access app covers this
# hostname: the survey is open to anyone. Everything maps into the app's /public/
# tree, so the admin tree cannot be reached from here, and the identity header is
# stripped. The results dashboard stays at kavinb.com/survey-admin/.
http://www.oceanfrontsurvey.com {
	redir https://oceanfrontsurvey.com{uri} 308
}
http://oceanfrontsurvey.com {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	request_header -Cf-Access-Authenticated-User-Email
	rewrite * /public{uri}
	reverse_proxy survey_api:8000
}

# On the tailnet, this listener owns kavinb.com directly (split-DNS points the
# name at the box's tailnet IP). Cloudflare is not in front here, so we assert
# the authenticated identity ourselves. header_up SETS the value, replacing any
# client-supplied copy, so it can't be spoofed. This site is only published on
# the tailnet IP (see compose.yml), never on the public interface.
(tailnet_identity) {
	header_up Cf-Access-Authenticated-User-Email kavinb@me.com
}

# ── Tailnet path ────────────────────────────────────────────────────────────
https://kavinb.com, https://www.kavinb.com {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	encode zstd gzip
	redir /money /money/ 308
	redir /workout /workout/ 308
	redir /health /health/ 308
	redir /trade /trade/ 308
	redir /survey https://oceanfrontsurvey.com/ 308
	redir /survey/ https://oceanfrontsurvey.com/ 308
	redir /survey-admin /survey-admin/ 308
	handle_path /money/* {
		reverse_proxy money_api:8000 {
			import tailnet_identity
		}
	}
	handle_path /workout/api/* {
		reverse_proxy workout_api:8000 {
			import tailnet_identity
		}
	}
	handle_path /workout/* {
		reverse_proxy workout_api:8000 {
			import tailnet_identity
		}
	}
	handle_path /health/* {
		reverse_proxy health_api:8000 {
			import tailnet_identity
		}
	}
	handle_path /trade/* {
		reverse_proxy trade_web:80
	}
	handle_path /survey/* {
		request_header -Cf-Access-Authenticated-User-Email
		rewrite * /public{uri}
		reverse_proxy survey_api:8000
	}
	handle_path /survey-admin/* {
		rewrite * /admin{uri}
		reverse_proxy survey_api:8000 {
			import tailnet_identity
		}
	}
	handle {
		respond "kavinb.com online (tailnet, auto-authenticated)." 200
	}
}
