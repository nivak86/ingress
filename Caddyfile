# Keep automatic-HTTPS cert management, but never auto-redirect HTTP→HTTPS: the
# public path below is HTTP-only on purpose (Cloudflare terminates TLS at the
# edge and dials the tunnel to caddy:80). A redirect here would break it.
{
	auto_https disable_redirects
	# abort runs before every other directive, so the tailnet-only guards below win over redir and handle
	order abort first
}

# ── Public path ─────────────────────────────────────────────────────────────
# Reached only through the Cloudflare tunnel (cloudflared → caddy:80). Cloudflare
# Access authenticates and injects Cf-Access-Authenticated-User-Email upstream.
http://kavinb.com, http://www.kavinb.com {
	encode zstd gzip
	redir /money /money/ 308
	redir /health /health/ 308
	# Mia (yumeeworld@gmail.com) has her own copy of Health with her own data (health_mia). Her
	# login only ever reaches that: every other path answers 404 for her. This handle sorts before
	# the handle_path routes below (Caddy runs handle before handle_path), so it always wins.
	@mia header_regexp mia Cf-Access-Authenticated-User-Email (?i)^yumeeworld@gmail\.com$
	handle @mia {
		handle_path /health/* {
			reverse_proxy health_mia:8000
		}
		handle {
			respond "Not found" 404
		}
	}
	handle_path /money/* {
		reverse_proxy money_api:8000
	}
	# Workout was folded into Health (Lift) on 2026-10-18; old links land there
	redir /workout* /health/lift 302
	handle_path /health/* {
		reverse_proxy health_api:8000
	}
	handle {
		respond "kavinb.com online. Money is at /money. Health (with Lift) is at /health." 200
	}
}

# On the tailnet, this listener owns kavinb.com directly (split-DNS points the
# name at the box's tailnet IP). Cloudflare is not in front here, so we assert
# the authenticated identity ourselves. header_up SETS the value, replacing any
# client-supplied copy, so it can't be spoofed. This site is only published on
# the tailnet IP (see compose.yml), never on the public interface.
(tailnet_identity) {
	header_up Cf-Access-Authenticated-User-Email kavinb@me.com
}

# ── Tailnet path ────────────────────────────────────────────────────────────
https://kavinb.com, https://www.kavinb.com {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	# F211, 7 Nov 2026: tailnet clients only. Containers on kavinb-public reach this listener on the
	# bridge IP and would otherwise get Kavin's identity and the proxy secrets added for them.
	@offtailnet not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	abort @offtailnet
	encode zstd gzip
	redir /money /money/ 308
	redir /health /health/ 308
	handle_path /money/* {
		reverse_proxy money_api:8000 {
			import tailnet_identity
			# Money takes the identity above only with this secret beside it (MONEY_ACCESS_VERIFY,
			# kavinb-money docs/lock.md). Only on Money's route, so no other app sees it.
			header_up X-Money-Proxy-Secret {env.MONEY_TAILNET_PROXY_SECRET}
		}
	}
	# Workout was folded into Health (Lift) on 2026-10-18; old links land there
	redir /workout* /health/lift 302
	handle_path /health/* {
		reverse_proxy health_api:8000 {
			import tailnet_identity
			# Health takes the identity above only with this secret beside it (HEALTH_ACCESS_VERIFY,
			# health docs/access.md). Only on Health's route, so no other app sees it.
			header_up X-Health-Proxy-Secret {env.HEALTH_TAILNET_PROXY_SECRET}
		}
	}
	handle {
		respond "kavinb.com online (tailnet, auto-authenticated)." 200
	}
}

# ── Rocky's door ─────────────────────────────────────────────────────────────
# Rocky is not Kavin. The Tailscale policy lets tag:rocky reach this port and not 443,
# so this is all it can open by web: the read-only endpoints its scripts use.
# Published on the tailnet IP only (see compose.yml).
https://kavinb.com:8444 {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	# F211, 7 Nov 2026: tailnet clients only. Containers on kavinb-public reach this listener on the
	# bridge IP and would otherwise get Kavin's identity and the proxy secrets added for them.
	@offtailnet not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	abort @offtailnet
	encode zstd gzip
	request_header -Cf-Access-Authenticated-User-Email
	@health_kavin {
		method GET
		path /health/api/ext/widget /health/api/weight /health/api/readiness
	}
	handle @health_kavin {
		uri strip_prefix /health
		reverse_proxy health_api:8000 {
			import tailnet_identity
			header_up X-Health-Proxy-Secret {env.HEALTH_TAILNET_PROXY_SECRET}
		}
	}
	@health_open {
		method GET
		path /health/api/health /health/api/integrations/oura/proxy/*
	}
	handle @health_open {
		uri strip_prefix /health
		reverse_proxy health_api:8000
	}
	@money_open {
		method GET
		path /money/api/ext/widget /money/api/health
	}
	handle @money_open {
		uri strip_prefix /money
		reverse_proxy money_api:8000
	}
	handle {
		respond "Not allowed from this device" 403
	}
}
