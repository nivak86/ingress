# /opt/ingress/.env on the box — NEVER commit the real file.
# The cloudflared connector token from the Cloudflare Zero Trust dashboard
# (Networks -> Tunnels -> your tunnel -> Configure -> the `--token` value).
TUNNEL_TOKEN=replace-with-cloudflared-connector-token

# Shared with /opt/kavinb-money/.env: proves Money's tailnet identity header came from this Caddy (openssl rand -hex 32)
MONEY_TAILNET_PROXY_SECRET=

# Shared with /opt/health/.env: proves Health's tailnet identity header came from this Caddy (openssl rand -hex 32)
HEALTH_TAILNET_PROXY_SECRET=
